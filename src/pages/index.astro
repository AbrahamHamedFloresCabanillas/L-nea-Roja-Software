---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Philosophy from "../components/Philosophy.astro";
import Code from "../components/Code.astro";
import Contract from "../components/Contract.astro";
import CaseStudies from "../components/CaseStudies.astro";
import Crisis from "../components/Crisis.astro";
import Investors from "../components/Investors.astro";
import Semester from "../components/Semester.astro";
import Closing from "../components/Closing.astro";
import Footer from "../components/Footer.astro";
---
<Base>
  <Header />
  <main id="contenido">
    <Hero />
    <Philosophy />
    <Code />
    <Contract />
    <CaseStudies />
    <Crisis />
    <Investors />
    <Semester />
    <Closing />
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/reveal.ts";
  import "../scripts/defer-layout.ts";
</script>
