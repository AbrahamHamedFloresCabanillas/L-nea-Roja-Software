---
import SectionHeader from "./SectionHeader.astro";
import { sectionName } from "../data/site";
import CaseTag from "./CaseTag.astro";
import Cite from "./Cite.astro";
import Icon from "./Icon.astro";
import { investorsIntro, investors } from "../data/investors";
---
<section class="section cv" id="inversores" aria-labelledby="inversores-title">
  <div class="container">
    <SectionHeader titleId="inversores-title" name={sectionName("inversores")} subtitle={investorsIntro.title} />
    <div class="inv-list">
      {investors.map((qa) => (
        <details class="inv-q" id={qa.id}>
          <summary>
            <span class="inv-q-text">{qa.q}</span>
            <Icon name="plus" class="chev" />
          </summary>
          <div class="inv-a">
            <p><strong>{qa.stance}</strong> {qa.argument}{qa.sources && <Cite ids={qa.sources} />}</p>
            <p><CaseTag id={qa.caseId} /></p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .inv-list { border-top: 1px solid var(--ink); max-width: 960px; }
  .inv-q { border-bottom: 1px solid var(--line); }
  .inv-q summary {
    display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start;
    padding: 20px 0; font-size: clamp(1.0625rem, 1.3vw, 1.25rem); font-weight: 500; line-height: 1.4; letter-spacing: -.01em;
  }
  .inv-q summary:hover .inv-q-text { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: .2em; }
  .inv-q .chev { margin-top: 4px; }
  .inv-a { display: grid; gap: 8px; padding: 0 40px 24px 17px; border-left: 3px solid var(--ink); margin-bottom: 20px; max-width: 72ch; color: var(--graphite); }
  .inv-a strong { color: var(--ink); font-weight: 600; }
</style>
