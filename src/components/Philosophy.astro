---
import SectionHeader from "./SectionHeader.astro";
import { sectionName } from "../data/site";
import CaseTag from "./CaseTag.astro";
import Icon from "./Icon.astro";
import { philosophy, concepts, moneyDecisions, internal } from "../data/philosophy";
---
<section class="section cv" id="filosofia" aria-labelledby="filosofia-title">
  <div class="container">
    <SectionHeader titleId="filosofia-title" name={sectionName("filosofia")} subtitle={philosophy.title} intro={philosophy.intro} />

    <figure class="statement" data-reveal>
      <blockquote><p class="display">{philosophy.statement}</p></blockquote>
      <figcaption class="statement-cap">
        <p>{philosophy.statementCase.text}</p>
        <CaseTag id={philosophy.statementCase.caseId} />
      </figcaption>
    </figure>

    <div class="block" id="conceptos">
      <h3 class="h3 block-title">Tres palabras que usamos con cuidado</h3>
      <dl class="concepts">
        {concepts.map((c) => (
          <div class="concept" data-reveal>
            <dt class="h3 concept-term">{c.term}</dt>
            <dd class="concept-def">{c.def}</dd>
            <dd class="concept-shop">
              <p class="sub">En el taller</p>
              <p>{c.workshop}</p>
              <p class="meta">{c.ref}.</p>
            </dd>
          </div>
        ))}
      </dl>
      <p class="small concepts-note">Los ejemplos “En el taller” salen de nuestra traducción del código de ética de la ACM a decisiones de todos los días.</p>
    </div>

    <div class="block">
      <div class="block-head">
        <h3 class="h3 block-title">Dinero contra buen software, en cuatro decisiones</h3>
        <p class="block-intro">Abre cada situación. A la izquierda, lo que empuja la métrica de negocio; a la derecha, lo que hacemos.</p>
      </div>
      <div class="decisions">
        {moneyDecisions.map((d) => (
          <details class="dec" id={d.id}>
            <summary>
              <span class="dec-q">{d.situation}</span>
              <Icon name="plus" class="chev" />
            </summary>
            <div class="dec-body">
              <div class="dec-col dec-money">
                <h4 class="sub">Lo que empuja el dinero</h4>
                <p>{d.money}</p>
              </div>
              <div class="dec-col dec-ours">
                <h4 class="sub">Lo que hacemos</h4>
                <p>{d.ours}</p>
              </div>
              <div class="dec-tag"><CaseTag id={d.caseId} /></div>
            </div>
          </details>
        ))}
      </div>
    </div>

    <div class="block" id="por-dentro">
      <div class="block-head">
        <h3 class="h3 block-title">Cómo trabajamos por dentro</h3>
        <p class="block-intro">Un manifiesto que solo mira hacia afuera es fácil de firmar. Estas reglas son para nosotros.</p>
      </div>
      <ul class="inside">
        {internal.map((r) => (
          <li class="inside-item" data-reveal>
            <h4 class="h4">{r.title}</h4>
            <p>{r.body}</p>
            <CaseTag id={r.caseId} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .statement { margin: 0 0 96px; padding-top: 40px; border-top: 1px solid var(--ink); }
  .statement blockquote { margin: 0; }
  .statement .display { max-width: 22ch; font-weight: 600; font-size: clamp(2rem, 4.6vw, 4.25rem); line-height: 1.02; letter-spacing: -.04em; }
  .statement-cap { margin-top: 32px; display: grid; gap: 12px; max-width: 60ch; color: var(--graphite); }
  @media (min-width: 1024px) { .statement-cap { margin-left: auto; margin-right: 0; } }

  .block { margin-top: 96px; }
  .block-head { display: grid; gap: 12px; margin-bottom: 32px; }
  @media (min-width: 1024px) { .block-head { grid-template-columns: 7fr 5fr; gap: 48px; align-items: end; } }
  .block-title { max-width: 24ch; }
  .block-intro { color: var(--graphite); max-width: 52ch; }
  #conceptos .block-title { margin-bottom: 32px; }

  .concepts { margin: 0; display: grid; border-top: 1px solid var(--ink); }
  .concept { padding: 28px 0; border-bottom: 1px solid var(--line); display: grid; gap: 12px; align-content: start; }
  @media (min-width: 900px) {
    .concepts { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }
    .concept { border-bottom: 0; padding: 32px 32px 32px 0; }
    .concept + .concept { border-left: 1px solid var(--line); padding-left: 32px; }
  }
  .concept dd { margin: 0; }
  .concept-def { color: var(--graphite); }
  .concept-shop { margin-top: 8px; padding: 16px; background: var(--surface); border-radius: var(--radius-md); }
  .concept-shop { display: grid; gap: 6px; }
  .concept-shop .meta { color: var(--graphite); }
  .concepts-note { margin-top: 16px; color: var(--muted); }

  .decisions { border-top: 1px solid var(--ink); }
  .dec { border-bottom: 1px solid var(--line); }
  .dec summary {
    display: grid; grid-template-columns: 1fr auto; gap: 16px; align-items: start;
    padding: 22px 0; font-size: 1.125rem; font-weight: 500; line-height: 1.4;
  }
  .dec summary:hover .dec-q { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: .2em; }
  .dec .chev { margin-top: 3px; }
  .dec-body { display: grid; gap: 16px; padding: 0 0 28px; }
  @media (min-width: 768px) { .dec-body { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .dec-col { padding: 4px 0 4px 18px; border-left: 3px solid; }
  .dec-col .sub { margin-bottom: 4px; }
  .dec-money { border-color: var(--red); }
  .dec-ours { border-color: var(--positive); }
  .dec-tag { grid-column: 1 / -1; }

  .inside { list-style: none; display: grid; border-top: 1px solid var(--ink); }
  .inside-item { padding: 28px 0; border-bottom: 1px solid var(--line); display: grid; gap: 10px; align-content: start; }
  .inside-item p { color: var(--graphite); }
  @media (min-width: 900px) {
    .inside { grid-template-columns: repeat(3, 1fr); border-bottom: 1px solid var(--line); }
    .inside-item { border-bottom: 0; padding: 32px 32px 32px 0; }
    .inside-item + .inside-item { border-left: 1px solid var(--line); padding-left: 32px; }
  }
</style>
