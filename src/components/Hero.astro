---
import Icon from "./Icon.astro";
---
<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container">
    <h1 id="hero-title" class="hero-title">No escribimos software a cualquier costo.</h1>
    <span class="hero-line" aria-hidden="true"></span>
    <p class="lead hero-lead">Somos una agencia de software de Mexicali. Construimos lo que el cliente necesita hasta donde la ética lo permite.</p>
    <a class="btn btn-primary hero-cta" href="#nosotros">Conócenos <Icon name="arrow-down" size={18} /></a>
  </div>
</section>

<style>
  .hero { padding-block: 64px 32px; }
  @media (min-width: 1024px) { .hero { min-height: calc(78vh - var(--header-h)); display: flex; align-items: center; padding-block: 80px; } }
  .hero-title {
    font-size: clamp(2.6rem, 11vw, 7rem);
    line-height: .94; letter-spacing: -.055em; font-weight: 600;
    max-width: 14ch;
  }
  @media (min-width: 480px) { .hero-title { font-size: clamp(3.25rem, 7.5vw, 7.5rem); } }
  .hero-line {
    display: block; height: 4px; width: min(100%, 520px);
    background: var(--red); margin-block: 32px;
    transform-origin: left center;
  }
  .hero-lead { margin-bottom: 32px; }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .hero-line { animation: draw 900ms var(--ease) 200ms both; }
    @keyframes draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  }
</style>
