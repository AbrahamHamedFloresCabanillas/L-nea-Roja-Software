---
import SectionHeader from "./SectionHeader.astro";
import { sectionName } from "../data/site";
import ManifestoRule from "./ManifestoRule.astro";
import PromptCalculator from "./PromptCalculator.astro";
import CancelWall from "./CancelWall.astro";
import ShameModal from "./ShameModal.astro";
import EvoMeter from "./EvoMeter.astro";
import { codeIntro, rules } from "../data/rules";
const [ia, patrones, ambiental] = rules;
---
<section class="section code on-dark" id="codigo" aria-labelledby="codigo-title">
  <div class="container">
    <SectionHeader titleId="codigo-title" name={sectionName("codigo")} subtitle={codeIntro.title} intro={codeIntro.intro} dark />

    <ManifestoRule rule={ia}>
      <div class="demo-stack">
        <PromptCalculator />
      </div>
    </ManifestoRule>

    <ManifestoRule rule={patrones}>
      <div class="demo-stack">
        <CancelWall />
        <ShameModal />
      </div>
    </ManifestoRule>

    <ManifestoRule rule={ambiental}>
      <div class="demo-stack">
        <EvoMeter />
      </div>
    </ManifestoRule>
  </div>
</section>

<style>
  .code {
    background: var(--dark); color: var(--dark-text);
    margin-top: var(--section-gap);
    padding-block: var(--section-gap);
  }
  .demo-stack { display: grid; gap: 72px; padding-top: 8px; }
  .demo-stack > :global(*) { padding-top: 40px; border-top: 1px solid #3a3b37; }
</style>
