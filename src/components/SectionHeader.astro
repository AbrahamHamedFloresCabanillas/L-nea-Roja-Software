---
import { sectionLabel, type SectionId } from "../data/site";
/** Label "0X / NOMBRE" con trazo rojo + título editorial + intro opcional (§2, §9). */
interface Props {
  section: SectionId;
  titleId: string;
  title: string;
  intro?: string;
  dark?: boolean;
}
const { section, titleId, title, intro, dark = false } = Astro.props;
---
<header class:list={["sh", { "sh-dark": dark }]} data-reveal>
  <p class="label sh-label"><span class="sh-line" aria-hidden="true"></span>{sectionLabel(section)}</p>
  <div class="sh-grid">
    <h2 id={titleId} class="h2 sh-title">{title}</h2>
    {intro && <p class="lead sh-intro">{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .sh { margin-bottom: 48px; }
  @media (min-width: 1024px) { .sh { margin-bottom: 72px; } }
  .sh-label { display: flex; align-items: center; gap: 12px; color: var(--red); margin-bottom: 24px; }
  .sh-line { width: 32px; height: 2px; background: currentColor; flex: none; }
  .sh-dark .sh-label { color: var(--red-on-dark); }
  .sh-grid { display: grid; gap: 20px; }
  .sh-title { max-width: 20ch; }
  @media (min-width: 1024px) {
    .sh-grid { grid-template-columns: 7fr 5fr; gap: 48px; align-items: end; }
  }
  .sh-dark .sh-intro { color: var(--dark-muted); }
</style>
