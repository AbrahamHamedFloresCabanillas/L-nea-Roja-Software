---
/**
 * Encabezado de sección: el h2 es el nombre de la sección (con la línea roja corta al lado)
 * y la frase editorial va debajo como subtítulo grande.
 */
interface Props {
  titleId: string;
  name: string;
  subtitle?: string;
  intro?: string;
  dark?: boolean;
}
const { titleId, name, subtitle, intro, dark = false } = Astro.props;
---
<header class:list={["sh", { "sh-dark": dark }]} data-reveal>
  <h2 id={titleId} class="sh-name"><span class="sh-line" aria-hidden="true"></span>{name}</h2>
  <div class="sh-grid">
    {subtitle && <p class="h2 sh-sub">{subtitle}</p>}
    {intro && <p class="lead sh-intro">{intro}</p>}
    <slot />
  </div>
</header>

<style>
  .sh { margin-bottom: 48px; }
  @media (min-width: 1024px) { .sh { margin-bottom: 72px; } }
  .sh-name {
    display: flex; align-items: center; gap: 14px;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem); line-height: 1.2; letter-spacing: -.015em; font-weight: 600;
    margin-bottom: 20px;
  }
  .sh-line { width: 32px; height: 3px; background: var(--red); flex: none; }
  .sh-dark .sh-line { background: var(--red-on-dark); }
  .sh-grid { display: grid; gap: 20px; }
  .sh-sub { max-width: 20ch; font-weight: 600; }
  @media (min-width: 1024px) {
    .sh-grid { grid-template-columns: 7fr 5fr; gap: 48px; align-items: start; }
  }
  .sh-dark .sh-intro { color: var(--dark-muted); }
</style>
