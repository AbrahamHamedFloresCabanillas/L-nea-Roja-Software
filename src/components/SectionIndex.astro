---
import { sections } from "../data/site";
import { ownersOf } from "../data/team";
const main = sections.filter((s) => "required" in s && s.required);
const minor = sections.filter((s) => ["casos", "inversores", "semestre", "fuentes"].includes(s.id));
---
<section class="section" id="indice" aria-labelledby="indice-title">
  <div class="container">
    <h2 id="indice-title" class="ix-title"><span class="ix-line" aria-hidden="true"></span>El manifiesto</h2>
    <ol class="ix-main">
      {main.map((s) => {
        const owner = ownersOf(s.id);
        return (
          <li>
            <a class="ix-row" href={`#${s.id}`}>
              <span class="ix-mark" aria-hidden="true"></span>
              <span class="ix-num tnum">{"num" in s ? s.num : ""}</span>
              <span class="ix-body">
                <span class="ix-name">{s.label}</span>
                <span class="ix-blurb">{"blurb" in s ? s.blurb : ""}</span>
              </span>
              {owner && <span class="ix-owner">{owner}</span>}
            </a>
          </li>
        );
      })}
    </ol>
    <ul class="ix-minor">
      {minor.map((s) => {
        const owner = ownersOf(s.id);
        return (
          <li>
            <a class="ix-row ix-row-sm" href={`#${s.id}`}>
              <span class="ix-mark" aria-hidden="true"></span>
              <span class="ix-name-sm">{s.label}</span>
              {owner && <span class="ix-owner">{owner}</span>}
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .ix-title {
    display: flex; align-items: center; gap: 14px; margin-bottom: 32px;
    font-size: clamp(1.25rem, 1.6vw, 1.5rem); line-height: 1.2; letter-spacing: -.015em;
  }
  .ix-line { width: 32px; height: 3px; background: var(--red); flex: none; }
  .ix-main, .ix-minor { list-style: none; }
  .ix-main { border-top: 1px solid var(--ink); }
  .ix-row {
    position: relative; display: grid; grid-template-columns: 2.2em 1fr; gap: 4px 16px; align-items: baseline;
    padding: 24px 0 24px 0; border-bottom: 1px solid var(--line);
    text-decoration: none; color: var(--ink);
    transition: padding-left 200ms var(--ease);
  }
  @media (min-width: 900px) { .ix-row { grid-template-columns: 2.5em 1fr auto; padding-block: 32px; } }
  .ix-mark { position: absolute; left: 0; top: 50%; width: 0; height: 3px; background: var(--red); transition: width 200ms var(--ease); }
  .ix-row:hover, .ix-row:focus-visible { padding-left: 44px; }
  .ix-row:hover .ix-mark, .ix-row:focus-visible .ix-mark { width: 28px; }
  .ix-num { color: var(--graphite); font-size: 1.125rem; font-weight: 500; }
  .ix-body { display: grid; gap: 6px; }
  .ix-name { font-size: clamp(1.75rem, 3.6vw, 3rem); font-weight: 600; line-height: 1.05; letter-spacing: -.035em; }
  .ix-blurb { color: var(--graphite); max-width: 52ch; }
  .ix-owner { grid-column: 2; color: var(--graphite); font-size: .875rem; }
  @media (min-width: 900px) { .ix-owner { grid-column: 3; text-align: right; max-width: 22ch; } }

  .ix-minor { display: grid; margin-top: 32px; border-top: 1px solid var(--line); }
  @media (min-width: 768px) { .ix-minor { grid-template-columns: repeat(4, 1fr); column-gap: 24px; } }
  .ix-row-sm { grid-template-columns: 1fr; padding-block: 16px; }
  @media (min-width: 900px) { .ix-row-sm { grid-template-columns: 1fr; padding-block: 18px; } }
  .ix-name-sm { font-size: 1.125rem; font-weight: 600; letter-spacing: -.01em; }
  .ix-row-sm .ix-owner { grid-column: 1; text-align: left; }
</style>
