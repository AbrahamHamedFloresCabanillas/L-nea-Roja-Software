---
import { caseById, type CaseId } from "../data/cases";
/** Enlace en texto normal que rastrea un bloque hasta su caso del semestre (ancla en la sección 07). */
interface Props { id?: CaseId; ids?: CaseId[] }
const list = (Astro.props.ids ?? (Astro.props.id ? [Astro.props.id] : [])).map(caseById);
const lead = list.length > 1 ? "De los casos:" : "Del caso:";
---
<span class="case-ref">{lead} {list.map((c, i) => (
  <>{i > 0 && (i === list.length - 1 ? " y " : ", ")}<a href={`#semestre-${c.id}`}>{c.title}</a></>
))}.</span>

<style>
  .case-ref { display: inline-block; font-size: .875rem; line-height: 1.5; color: var(--graphite); }
  .case-ref a { color: var(--ink); text-underline-offset: .2em; display: inline-block; min-height: 24px; }
  .case-ref a:hover { text-decoration-color: var(--red); }
  :global(.on-dark) .case-ref { color: var(--dark-muted); }
  :global(.on-dark) .case-ref a { color: var(--dark-text); }
  :global(.on-dark) .case-ref a:hover { text-decoration-color: var(--red-on-dark); }
  :global(.pc) .case-ref, :global(.evo-meter-box) .case-ref { color: var(--graphite); }
  :global(.pc) .case-ref a { color: var(--ink); }
</style>
