---
import Cite from "./Cite.astro";
import { promptOptions, promptFacts, TEXT_WH } from "../data/demos";

const fmt = (n: number) => n.toLocaleString("es-MX", { maximumFractionDigits: n < 10 ? 2 : n < 100 ? 1 : 0 });
const range = (a: number, b: number) => (a === b ? `${fmt(a)}` : `${fmt(a)}–${fmt(b)}`);
const eq = (a: number, b: number) => {
  const lo = Math.round(a / TEXT_WH), hi = Math.round(b / TEXT_WH);
  return lo === hi ? fmt(lo) : `${fmt(lo)} a ${fmt(hi)}`;
};
const maxLog = Math.log10(promptOptions[promptOptions.length - 1].wh[1] / TEXT_WH);
const bar = (wh: number) => Math.max(1.5, ((Math.log10(wh / TEXT_WH) + 0.3) / (maxLog + 0.3)) * 100);
const def = promptOptions.find((o) => o.id === "imagenes")!;
---
<section class="pc cv" id="demo-gato" aria-labelledby="pc-title" data-calc>
  <h4 id="pc-title" class="h3 pc-title">¿Cuánto cuesta un gato astronauta?</h4>
  <p class="pc-intro">Elige qué le pides a la IA. Energía por cada vez.</p>

  <div class="pc-grid">
    <fieldset class="pc-options">
      <legend class="sr-only">Qué le pides a la IA</legend>
      {promptOptions.map((o) => (
        <label class="pc-opt">
          <input type="radio" name="prompt" value={o.id} checked={o.id === def.id}
            data-lo={o.wh[0]} data-hi={o.wh[1]} data-label={o.label} />
          <span class="pc-opt-text">
            <span class="pc-opt-label">{o.label}</span>
            <Cite ids={o.sources} />
          </span>
          <span class="pc-opt-wh tnum">{range(o.wh[0], o.wh[1])} Wh</span>
          <span class="pc-bar" aria-hidden="true"><i style={`width:${bar(o.wh[1])}%`}></i></span>
        </label>
      ))}
    </fieldset>

    <div class="pc-out" aria-live="polite">
      <p class="meta pc-out-label" data-out-label>{def.label}</p>
      <p class="pc-out-num"><span data-out-wh>{range(def.wh[0], def.wh[1])}</span> <span class="pc-unit">Wh</span></p>
      <p class="pc-out-eq">Equivale a <strong data-out-eq>{eq(def.wh[0], def.wh[1])}</strong> preguntas de texto.</p>
      <p class="pc-out-scale">Un millón de personas al día: <strong data-out-scale>{range(def.wh[0], def.wh[1])} MWh</strong>.</p>
      <p class="small pc-note">{promptFacts.note}</p>
    </div>
  </div>

  <div class="pc-method">
    <h5 class="sub">De dónde salen las cifras</h5>
    <ul>{promptFacts.method.map((m) => <li>{m}</li>)}</ul>
    <p class="meta">Fuentes: <Cite ids={["google-gemini", "mittr", "luccioni"]} /></p>
  </div>
  <p class="pc-thesis">“{promptFacts.thesis}”</p>
</section>

<style>
  .pc {
    background: var(--paper); color: var(--ink);
    border-radius: var(--radius-lg); padding: clamp(20px, 4vw, 40px);
    display: grid; gap: 16px;
    container-type: inline-size;
  }
  .pc-intro { color: var(--graphite); }
  .pc-grid { display: grid; gap: 24px; margin-top: 8px; }
  @container (min-width: 700px) { .pc-grid { grid-template-columns: 1.5fr 1fr; align-items: start; } }

  .pc-options { margin: 0; padding: 0; border: 0; display: grid; gap: 8px; min-width: 0; }
  .pc-opt {
    position: relative;
    display: grid; grid-template-columns: 20px 1fr; gap: 4px 12px;
    padding: 14px 16px; border: 1px solid var(--line-strong); border-radius: var(--radius-md);
    cursor: pointer; background: var(--paper);
    transition: border-color 160ms var(--ease);
  }
  .pc-opt:hover { border-color: var(--ink); }
  .pc-opt:has(input:checked) { border-color: var(--ink); box-shadow: inset 0 0 0 1px var(--ink); background: #fff; }
  .pc-opt input { margin: 3px 0 0; width: 18px; height: 18px; accent-color: var(--ink); }
  .pc-opt-text { display: grid; gap: 2px; min-width: 0; }
  .pc-opt-label { font-weight: 500; }
  .pc-opt-detail { font-size: .875rem; color: var(--graphite); }
  .pc-opt-wh { grid-column: 2; font-size: .875rem; font-weight: 500; }
  .pc-bar { grid-column: 2; height: 6px; background: var(--surface); border-radius: 3px; overflow: hidden; }
  .pc-bar i { display: block; height: 100%; background: var(--ink); border-radius: 3px; }
  .pc-opt:has(input:checked) .pc-bar i { background: var(--red); }

  .pc-out { border: 1px solid var(--ink); border-radius: var(--radius-md); padding: 24px; display: grid; gap: 10px; background: #fff; }
  @container (min-width: 700px) { .pc-out { position: sticky; top: calc(var(--header-h) + 24px); } }
  .pc-out-num { font-size: clamp(1.75rem, 6cqw, 2.75rem); line-height: 1; font-weight: 600; letter-spacing: -.03em; font-variant-numeric: tabular-nums; }
  .pc-unit { font-size: .45em; color: var(--graphite); }
  .pc-out-eq, .pc-out-scale { color: var(--graphite); }
  .pc-out strong { color: var(--ink); }
  .pc-method { display: grid; gap: 6px; padding-top: 16px; border-top: 1px solid var(--line); font-size: .875rem; color: var(--graphite); }
  .pc-method ul { padding-left: 18px; display: grid; gap: 4px; }
  .pc-note { color: var(--muted); padding-top: 10px; border-top: 1px solid var(--line); }

  .pc-facts { display: grid; gap: 20px; margin-top: 16px; padding-top: 24px; border-top: 1px solid var(--line); }
  @container (min-width: 700px) { .pc-facts { grid-template-columns: repeat(3, 1fr); gap: 32px; } }
  .pc-facts .sub { margin-bottom: 6px; }
  .pc-facts p, .pc-facts li { font-size: .9375rem; color: var(--graphite); }
  .pc-facts ul { padding-left: 18px; display: grid; gap: 4px; }

  .pc-thesis { font-size: clamp(1.25rem, 2vw, 1.6rem); font-weight: 600; letter-spacing: -.02em; line-height: 1.3; margin-top: 8px; display: grid; gap: 8px; }
  .pc :global(.case-tag) { color: var(--graphite); }
  .pc :global(.case-tag-dot) { background: var(--red); }
</style>

<script>
  const TEXT_WH = 0.24;
  const fmt = (n: number) => n.toLocaleString("es-MX", { maximumFractionDigits: n < 10 ? 2 : n < 100 ? 1 : 0 });
  const range = (a: number, b: number) => (a === b ? fmt(a) : `${fmt(a)}–${fmt(b)}`);
  const eq = (a: number, b: number) => {
    const lo = Math.round(a / TEXT_WH), hi = Math.round(b / TEXT_WH);
    return lo === hi ? fmt(lo) : `${fmt(lo)} a ${fmt(hi)}`;
  };

  document.querySelectorAll<HTMLElement>("[data-calc]").forEach((root) => {
    const q = <T extends HTMLElement>(s: string) => root.querySelector<T>(s)!;
    const update = (input: HTMLInputElement) => {
      const lo = Number(input.dataset.lo), hi = Number(input.dataset.hi);
      q("[data-out-label]").textContent = input.dataset.label ?? "";
      q("[data-out-wh]").textContent = range(lo, hi);
      q("[data-out-eq]").textContent = eq(lo, hi);
      q("[data-out-scale]").textContent = `${range(lo, hi)} MWh`;
    };
    root.querySelectorAll<HTMLInputElement>('input[name="prompt"]').forEach((i) => i.addEventListener("change", () => update(i)));
  });
</script>
