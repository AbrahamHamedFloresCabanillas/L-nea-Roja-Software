---
import SectionHeader from "./SectionHeader.astro";
import { sectionName } from "../data/site";
import { cases } from "../data/cases";
---
<section class="section cv" id="semestre" aria-labelledby="semestre-title">
  <div class="container">
    <SectionHeader titleId="semestre-title" name={sectionName("semestre")} subtitle="Diez casos, un manifiesto." />
    <ol class="sm-list">
      {cases.map((c) => (
        <li class="sm-row" id={`semestre-${c.id}`}>
          <span class="sm-dot" aria-hidden="true"></span>
          <p class="sm-name">{c.title}</p>
          <p class="sm-lesson">{c.lesson}</p>
          <a class="sm-link" href={c.href}>Ver dónde se usa</a>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sm-list { list-style: none; border-top: 2px solid var(--red); }
  .sm-row { position: relative; display: grid; gap: 4px; padding: 16px 0 16px 24px; border-bottom: 1px solid var(--line); }
  @media (min-width: 900px) { .sm-row { grid-template-columns: 4fr 6fr 2fr; gap: 24px; align-items: baseline; } }
  .sm-dot { position: absolute; left: 0; top: 24px; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--red); }
  .sm-name { font-weight: 600; }
  .sm-lesson { color: var(--graphite); }
  .sm-link { font-size: .9375rem; min-height: 24px; }
  @media (min-width: 900px) { .sm-link { justify-self: end; } }
</style>
